if BOARD_VUA_LEFT

config ZMK_KEYBOARD_NAME
	default "VU.A"

# The left half is the central: it talks to the host and to the right half.
config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif # BOARD_VUA_LEFT

if BOARD_VUA_RIGHT

config ZMK_KEYBOARD_NAME
	default "VU.A right"

endif # BOARD_VUA_RIGHT

if BOARD_VUA_LEFT || BOARD_VUA_RIGHT

config ZMK_SPLIT
	default y

config ZMK_BATTERY_VOLTAGE_DIVIDER
	default y

# Increase the radio transmit power. Guarded by BT so builds with the BLE stack
# off (e.g. settings_reset) don't select into a choice that has no selection.
if BT

choice BT_CTLR_TX_PWR
	default BT_CTLR_TX_PWR_PLUS_8
endchoice

endif # BT

if USB

config USB_DEVICE_STACK
	default y

config USB_NRFX
	default y

endif # USB

endif # BOARD_VUA_LEFT || BOARD_VUA_RIGHT
