/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    model = "VUA";
    compatible = "deemen17,vua";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        /*
         * Points at the physical layout rather than at the transform directly.
         * ZMK Studio reads key geometry from a "zmk,physical-layout" node and a
         * bare matrix transform carries none, so choosing the transform here
         * would leave Studio with nothing to draw. The layout wraps the same
         * transform, so key ordering is unchanged.
         */
        zmk,physical-layout = &default_layout;
    };

    behaviors {
        /*
         * Hold-to-reset, wired to two keys per half via kscan sideband entries
         * (see the per-half .dts files). Sideband entries run locally on the
         * half that owns the key, without any keymap processing, so this is how
         * the peripheral can reset itself while disconnected from the central.
         *
         * One action per key, both after a 3 second hold, decided on release.
         * A tap is ignored, so each key keeps its normal meaning.
         */
        hold_rst: hold_rst {
            compatible = "zmk,behavior-hold-reset";
            #binding-cells = <0>;
            hold-time-ms = <3000>;
            display-name = "Hold Reset";
        };

        hold_boot: hold_boot {
            compatible = "zmk,behavior-hold-reset";
            #binding-cells = <0>;
            hold-time-ms = <3000>;
            bootloader;
            display-name = "Hold Bootloader";
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1)   RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8)       RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)
            RC(1,0) RC(1,1)   RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)               RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17)
            RC(2,0) RC(2,1)	  RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)	            RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)          RC(2,16) RC(2,17)
            RC(3,0) RC(3,1)	  RC(3,2)         RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8)               RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17)
            RC(4,0) RC(4,1)	  RC(4,2) RC(4,3)         RC(4,5) RC(4,6) RC(4,7)                       RC(4,10)                   RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17)
        >;
    };

    /*
     * Physical layout: the same 80 key positions as the transform above, plus
     * the geometry ZMK Studio needs to render the board. Positions are in
     * centi-keyunits (100 = 1u), taken from config/info.json, and listed in
     * transform-map order — Studio matches keys to bindings by index, so the
     * two lists must stay in the same order and the same length.
     */
    default_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>   // M1
            , <&key_physical_attrs 100 100  100    0       0     0     0>   // M2
            , <&key_physical_attrs 100 100  225    0       0     0     0>   // Esc
            , <&key_physical_attrs 100 100  325    0       0     0     0>   // 1
            , <&key_physical_attrs 100 100  425    0       0     0     0>   // 2
            , <&key_physical_attrs 100 100  525    0       0     0     0>   // 3
            , <&key_physical_attrs 100 100  625    0       0     0     0>   // 4
            , <&key_physical_attrs 100 100  725    0       0     0     0>   // 5
            , <&key_physical_attrs 100 100  825    0       0     0     0>   // 6
            , <&key_physical_attrs 100 100 1125    0       0     0     0>   // 7
            , <&key_physical_attrs 100 100 1225    0       0     0     0>   // 8
            , <&key_physical_attrs 100 100 1325    0       0     0     0>   // 9
            , <&key_physical_attrs 100 100 1425    0       0     0     0>   // 0
            , <&key_physical_attrs 100 100 1525    0       0     0     0>   // Minus
            , <&key_physical_attrs 100 100 1625    0       0     0     0>   // Equal
            , <&key_physical_attrs 100 100 1725    0       0     0     0>   // Backspace
            , <&key_physical_attrs 100 100 1825    0       0     0     0>   // Backspace
            , <&key_physical_attrs 100 100 1925    0       0     0     0>   // Home

            , <&key_physical_attrs 100 100    0  100       0     0     0>   // M3
            , <&key_physical_attrs 100 100  100  100       0     0     0>   // M4
            , <&key_physical_attrs 150 100  225  100       0     0     0>   // Tab
            , <&key_physical_attrs 100 100  375  100       0     0     0>   // Q
            , <&key_physical_attrs 100 100  475  100       0     0     0>   // W
            , <&key_physical_attrs 100 100  575  100       0     0     0>   // E
            , <&key_physical_attrs 100 100  675  100       0     0     0>   // R
            , <&key_physical_attrs 100 100  775  100       0     0     0>   // T
            , <&key_physical_attrs 100 100 1075  100       0     0     0>   // Y
            , <&key_physical_attrs 100 100 1175  100       0     0     0>   // U
            , <&key_physical_attrs 100 100 1275  100       0     0     0>   // I
            , <&key_physical_attrs 100 100 1375  100       0     0     0>   // O
            , <&key_physical_attrs 100 100 1475  100       0     0     0>   // P
            , <&key_physical_attrs 100 100 1575  100       0     0     0>   // Left Bracket
            , <&key_physical_attrs 100 100 1675  100       0     0     0>   // Right Bracket
            , <&key_physical_attrs 150 100 1775  100       0     0     0>   // Slash
            , <&key_physical_attrs 100 100 1925  100       0     0     0>   // End

            , <&key_physical_attrs 100 100    0  200       0     0     0>   // M5
            , <&key_physical_attrs 100 100  100  200       0     0     0>   // M6
            , <&key_physical_attrs 175 100  225  200       0     0     0>   // Caps Lock
            , <&key_physical_attrs 100 100  400  200       0     0     0>   // A
            , <&key_physical_attrs 100 100  500  200       0     0     0>   // S
            , <&key_physical_attrs 100 100  600  200       0     0     0>   // D
            , <&key_physical_attrs 100 100  700  200       0     0     0>   // F
            , <&key_physical_attrs 100 100  800  200       0     0     0>   // G
            , <&key_physical_attrs 100 100 1100  200       0     0     0>   // H
            , <&key_physical_attrs 100 100 1200  200       0     0     0>   // J
            , <&key_physical_attrs 100 100 1300  200       0     0     0>   // K
            , <&key_physical_attrs 100 100 1400  200       0     0     0>   // L
            , <&key_physical_attrs 100 100 1500  200       0     0     0>   // Scolon
            , <&key_physical_attrs 100 100 1600  200       0     0     0>   // Quote
            , <&key_physical_attrs 225 100 1700  200       0     0     0>   // Enter
            , <&key_physical_attrs 100 100 1925  200       0     0     0>   // PgUp

            , <&key_physical_attrs 100 100    0  300       0     0     0>   // M7
            , <&key_physical_attrs 100 100  100  300       0     0     0>   // M8
            , <&key_physical_attrs 225 100  225  300       0     0     0>   // Shift
            , <&key_physical_attrs 100 100  450  300       0     0     0>   // Z
            , <&key_physical_attrs 100 100  550  300       0     0     0>   // X
            , <&key_physical_attrs 100 100  650  300       0     0     0>   // C
            , <&key_physical_attrs 100 100  750  300       0     0     0>   // V
            , <&key_physical_attrs 100 100  850  300       0     0     0>   // B
            , <&key_physical_attrs 100 100 1150  300       0     0     0>   // N
            , <&key_physical_attrs 100 100 1250  300       0     0     0>   // M
            , <&key_physical_attrs 100 100 1350  300       0     0     0>   // Comma
            , <&key_physical_attrs 100 100 1450  300       0     0     0>   // Dot
            , <&key_physical_attrs 100 100 1550  300       0     0     0>   // Back Slash
            , <&key_physical_attrs 175 100 1650  300       0     0     0>   // Shift
            , <&key_physical_attrs 100 100 1825  300       0     0     0>   // Up
            , <&key_physical_attrs 100 100 1925  300       0     0     0>   // PgDn

            , <&key_physical_attrs 100 100    0  400       0     0     0>   // M9
            , <&key_physical_attrs 100 100  100  400       0     0     0>   // M10
            , <&key_physical_attrs 150 100  225  400       0     0     0>   // Ctrl
            , <&key_physical_attrs 100 100  375  400       0     0     0>   // Gui
            , <&key_physical_attrs 100 100  525  400       0     0     0>   // Alt
            , <&key_physical_attrs 100 100  625  400       0     0     0>   // Fn
            , <&key_physical_attrs 225 100  725  400       0     0     0>   // Space
            , <&key_physical_attrs 300 100 1150  400       0     0     0>   // Space
            , <&key_physical_attrs 125 100 1450  400       0     0     0>   // Alt
            , <&key_physical_attrs 100 100 1575  400       0     0     0>   // Ctrl
            , <&key_physical_attrs 100 100 1725  400       0     0     0>   // Left
            , <&key_physical_attrs 100 100 1825  400       0     0     0>   // Down
            , <&key_physical_attrs 100 100 1925  400       0     0     0>   // Right
            ;
    };

};

/*
 * DC/DC regulators. The pre-HWMv2 config enabled both stages via
 * CONFIG_SOC_DCDC_NRF52X and CONFIG_SOC_DCDC_NRF52X_HV, which are consumed in
 * soc/nordic/nrf52/soc.c; the devicetree equivalents below are what that same
 * code now checks. reg1 is the DCC-pin stage, reg0 the high-voltage DCCH stage.
 */
&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&reg0 {
    status = "okay";
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    /*
     * For more information, see:
     * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };

        /*
         * The flash starting at 0x000ec000 and ending at
         * 0x000f3fff is reserved for use by the application.
         */

        /*
         * Storage partition will be used by FCB/LittleFS/NVS
         * if enabled.
         */
        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
